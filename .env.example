# ============================================================================
# Onefend Configuration
# Copy this file to .env and update the values before running docker-compose
# ============================================================================

# ---- SERVER ADDRESS ----
# The IP or hostname where users will access Onefend.
# This is used for CORS, cookie settings, and extension configuration.
#
# Examples:
#   Internal server:  http://10.0.1.50
#   Internal DNS:     http://onefend.internal
#   Public domain:    https://onefend.yourcompany.com
#
# For HTTPS, set COOKIE_SECURE=true (see below)
SERVER_URL=http://YOUR_SERVER_IP_OR_HOSTNAME

# Port to expose Onefend on (default: 80)
# Users access the dashboard at SERVER_URL:PORT
# PORT=80

# ---- SECURITY ----
# Database password (change this!)
# IMPORTANT: Use only letters, numbers, and underscores. Avoid special characters
# like @, $, !, & as they break the database connection URL.
POSTGRES_PASSWORD=change-this-password

# JWT secret (minimum 32 characters -- generate with: openssl rand -hex 32)
# WARNING: The backend will refuse to start if this is left as the default value.
JWT_SECRET=change-this-to-a-random-secret

# ---- ADMIN ACCOUNT ----
# Created automatically on first boot
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=ChangeThisPassword123!

# ---- COOKIE SECURITY ----
# Set to true ONLY if you are using HTTPS (TLS termination via reverse proxy)
# COOKIE_SECURE=false

# Cookie domain (only needed for subdomain setups, e.g. .yourcompany.com)
# COOKIE_DOMAIN=

# ---- EMAIL (optional) ----
# Without SMTP, enrollment tokens must be shared manually.
# With SMTP, Onefend sends invitation emails with setup instructions.
#
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=noreply@yourcompany.com
# SMTP_PASS=your-app-password
# MAIL_FROM=noreply@yourcompany.com

# ---- GOOGLE CLOUD AI (optional) ----
# Without GCP, Onefend uses regex-based detection only.
# With GCP, adds AI-powered content classification, PII redaction, and document analysis.
# Works from any deployment location (GCP, AWS, Azure, on-premise).
#
# Note: On GCP infrastructure (Cloud Run, GKE, Compute Engine), you can skip
# GCP_CLIENT_EMAIL and GCP_PRIVATE_KEY. The SDK uses ADC automatically.
#
# GCP_PROJECT_ID=your-project-id
# GCP_CLIENT_EMAIL=your-sa@your-project.iam.gserviceaccount.com
# GCP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# GCP_DOCAI_PROCESSOR_ID=your-processor-id
# GCP_MODEL=gemini-3.1-flash-lite  # Required. Check available models at Vertex AI Model Garden
# GCP_LOCATION=us                   # Use 'us' or 'eu' for models 3.x+, 'us-central1' for models 2.x

# ---- ADVANCED ----
# NODE_ENV=production
# REDIS_PASSWORD=
