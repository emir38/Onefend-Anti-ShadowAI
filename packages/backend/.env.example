# Backend development configuration (local dev without Docker)
# For Docker deployments, use the root .env.example instead

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/onefend

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# JWT
JWT_SECRET=change-this-to-a-random-secret

# Application
NODE_ENV=development
PORT=3000
APP_NAME=Onefend
SERVER_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3001

# Google Cloud Platform (required for AI analysis features)
GCP_PROJECT_ID=your-gcp-project-id
GCP_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GCP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nyour-key-here\n-----END RSA PRIVATE KEY-----"
# GCP_KEY_FILE=/path/to/service-account-key.json  # Alternative to GCP_PRIVATE_KEY

# Google Document AI (required for document analysis)
GCP_DOCAI_PROCESSOR_ID=your-processor-id

# Google Cloud Storage (optional, for document storage)
# GCP_DOCS_BUCKET=your-bucket-name
