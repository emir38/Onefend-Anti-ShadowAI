{
    "manifest_version": 3,
    "name": "Onefend — AI Security & Data Protection",
    "version": "1.0.5",
    "description": "Protect sensitive data from being shared with AI chatbots. Enterprise DLP & governance for ChatGPT, Claude, Gemini and more.",
    "icons": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    },
    "permissions": [
        "storage",
        "declarativeNetRequest",
        "declarativeNetRequestFeedback",
        "alarms"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "browser_specific_settings": {
        "gecko": {
            "id": "onefend@onefend.com",
            "strict_min_version": "128.0",
            "data_collection_permissions": {
                "required": [
                    "personallyIdentifyingInfo",
                    "financialAndPaymentInfo",
                    "authenticationInfo",
                    "browsingActivity",
                    "websiteActivity",
                    "websiteContent"
                ]
            }
        }
    },
    "background": {
        "service_worker": "src/background/index.ts",
        "type": "module"
    },
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self'"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "src/content/network-interceptor.ts"
            ],
            "run_at": "document_start",
            "world": "MAIN",
            "all_frames": false
        },
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "src/content/index.ts"
            ],
            "run_at": "document_idle",
            "all_frames": false
        }
    ],
    "action": {
        "default_icon": {
            "16": "icons/icon-16.png",
            "32": "icons/icon-32.png"
        },
        "default_popup": "src/popup/popup.html"
    },
    "web_accessible_resources": [
        {
            "resources": [
                "src/pages/blocked.html"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ]
}